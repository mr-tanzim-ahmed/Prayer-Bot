# Gitignore for Prayer‑Bot

# Build output and PlatformIO dependencies
.pio/

# IDE configuration files (VS Code)
.vscode/

# PlatformIO project configuration (keep locally, not needed in repo)
platformio.ini

# Runtime data / generated files – keep out of version control
/data/

# Any other transient files (e.g., compiled binaries)
*.bin
*.elf
*.map

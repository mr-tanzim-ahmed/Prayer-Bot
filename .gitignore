# Gitignore for Prayer‑Bot

# Build output and PlatformIO dependencies
.pio/

# IDE configuration files (VS Code)
.vscode/

# Runtime data / generated files – keep out of version control, except bundled audio
/data/*
!/data/.gitkeep
!/data/beep_sound.wav
!/data/PrayerBot_Arrow.svg

# Any other transient files (e.g., compiled binaries)
*.bin
*.elf
*.map
secrets.h
Prayer-Bot.code-workspace
